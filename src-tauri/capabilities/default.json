{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "notification:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://store.steampowered.com/api/*" },
        { "url": "https://api.steampowered.com/ISteamNews/*" },
        { "url": "https://api.steampowered.com/IStoreBrowseService/*" },
        { "url": "https://*.steamstatic.com/*" }
      ]
    }
  ]
}
