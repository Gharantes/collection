{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "collection",
  "version": "1.0.3",
  "identifier": "com.gharantes.collection",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Collection",
        "width": 1200,
        "height": 800,
        "theme": "Dark",
        "backgroundColor": "#0d0f14",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGMzRCMTMyRTNCRDg1RTEKUldUaGhiM2pNckUwenlISmZUdVZkNG1UTWNMTVRjdWxDTldSZEk4ZzlBQllYV3loSUNxVjVCWUIK",
      "endpoints": [
        "https://github.com/Gharantes/collection/releases/latest/download/latest.json"
      ]
    }
  }
}
